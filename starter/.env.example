# ------------------------------------------------------------------
# Server-side settings for the Campus Events app.
#
# Vercel (primary workflow): add these exact names in project Settings ->
# Environment Variables for Production (and Preview if used), then redeploy.
# Connecting Supabase supplies configuration; routes/frontend still need work.
#
# Optional local workflow: copy this file to .env.local in the same folder,
# replace placeholders with your TEACHING project values, then restart npm run dev.
#
# .env.local is listed in .gitignore. Never commit it, paste it into chat,
# or share it in screenshots.
# ------------------------------------------------------------------

# Project URL: Supabase dashboard -> Connect (or Project Settings -> Data API).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Secret key: Supabase dashboard -> Project Settings -> API Keys -> Secret keys
# (starts with "sb_secret_"). Older projects can use the legacy "service_role" key instead.
#
# This key can read and write every table, so it must stay on the server:
#   - The name does NOT start with NEXT_PUBLIC_, so Next.js will not send it to the browser.
#   - Only lib/supabase-server.js reads it.
# Do NOT use the publishable/anon key here. The database setup blocks that key on purpose.
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY
